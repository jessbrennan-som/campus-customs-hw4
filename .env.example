# Copy this file to .env (never commit the real .env) and fill in the placeholders.
# Put it in the hw4 folder or in the backend folder, or any folder above them: the API looks upward for a .env.

# The AI service key (Portkey). Required for the chatbot; the rest of the site works without it.
PORTKEY_API_KEY=your-portkey-key-here

# Optional settings (the defaults shown are fine for local use)
# SHOP_MODEL=gpt-5.6-luna
# FRONTEND_URL=http://localhost:5173
# ADMIN_EMAILS=you@example.com        # comma-separated; who may read customer feedback and learned lessons

# Optional: send real email instead of saving it as text files in backend/outbox/
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=shop@example.com
